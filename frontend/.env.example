# Local development (optional; this is the default when the FastAPI service is
# running on port 8000):
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Production: do not set VITE_API_BASE_URL in Vercel. Production requests use
# Vercel's /api rewrite, which forwards to Render without browser CORS issues.

# The AI Commentary page also requires a Supabase project:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

