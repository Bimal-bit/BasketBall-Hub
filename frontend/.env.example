# Local development (optional; this is the default when the FastAPI service is
# running on port 8000):
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Production (required): Set this in Vercel Project Settings → Environment
# Variables for Production and Preview. Use the public URL of *your* Render
# service; do not copy an old onrender.com hostname from project documentation.
# VITE_API_BASE_URL=https://your-render-service.onrender.com/api

# The AI Commentary page also requires a Supabase project:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

